{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Storage": {
    "SqlitePath": "data/sharpagent.db"
  },
  "Idempotency": {
    "$comment": "Retention is documented as 24 hours (technical design section 5.3).",
    "RetentionHours": 24
  },
  "Retention": {
    "WorktreeHours": 24,
    "ToolOutputHours": 168
  }
}
