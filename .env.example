# SharpAgent environment template.
# Copy to `.env` for local use. NEVER commit real values; `.env` is Git-ignored.
#
# Provider keys are resolved SERVER-SIDE ONLY from the process environment.
# The browser never receives or sends provider credentials.

# OpenCode Go Plan API key used by local opt-in live tests and the backend adapter.
SHARPAGENT_OPENCODE_GO_API_KEY=<set-locally-never-commit>

# Opt-in flag for the local live provider smoke suite (see scripts/run-live-opencode-smoke.ps1).
RUN_LIVE_PROVIDER_TESTS=<unset-or-1>

# Frontend build-time variables must never carry secrets; none are required in Phase 0.
